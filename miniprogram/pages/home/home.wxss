.hd {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 24rpx 0 4rpx;
}

.hd-kicker {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #706E68;
}

.hd-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #1A1A18;
  margin-top: 4rpx;
}

.hd-right {
  text-align: right;
}

.hd-updated {
  font-size: 20rpx;
  color: #706E68;
}

.tabs-wrap {
  margin: 6rpx -32rpx 6rpx;
  --td-tab-item-height: 76rpx;
  --td-tab-font: 26rpx / 40rpx -apple-system, 'PingFang SC', sans-serif;
  --td-tab-nav-bg-color: #FAFAF8;
  --td-tab-track-thickness: 4rpx;
  --td-tab-track-width: 28rpx;
  --td-tab-border-color: transparent;
  --td-spacer-2: 24rpx;
}

.feed-controls { position:sticky;top:0;z-index:10;background:#FAFAF8;padding-top:4rpx;padding-bottom:2rpx; }
.feed-update-anchor { position:absolute;top:100%;left:0;right:0;display:flex;justify-content:center;padding-top:10rpx;pointer-events:none; }
.feed-update-button { pointer-events:auto;margin:0;padding:12rpx 26rpx;min-height:68rpx;box-sizing:border-box;border-radius:40rpx;background:#EEF0F7;color:#59617E;font-size:24rpx;line-height:1.8;box-shadow:0 4rpx 16rpx rgba(30,30,24,.08); }
.feed-update-button::after { border:none; }
.feed-update-pressed { background:#E1E5F0; }

.sort-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.search-entry {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  margin: -12rpx -12rpx -12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-entry-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  color: #5F5E5A;
  transition: transform 140ms ease, background-color 140ms ease;
}
.search-glyph { position: relative; width: 34rpx; height: 34rpx; }
.search-glyph-ring {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
  border: 2.8rpx solid currentColor;
  border-radius: 50%;
}
.search-glyph-handle {
  position: absolute;
  left: 23rpx;
  top: 22rpx;
  width: 13rpx;
  height: 2.8rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(45deg);
  transform-origin: 1rpx center;
}
.search-entry-pressed .search-entry-surface { background: #EBEBE6; transform: scale(0.94); }
@media (prefers-reduced-motion: reduce) {
  .search-entry-surface { transition: none; }
  .search-entry-pressed .search-entry-surface { transform: none; }
}

.sort-control {
  position: relative;
  display: flex;
  align-items: center;
  padding: 5rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.sort-indicator {
  position: absolute;
  z-index: 0;
  top: 5rpx;
  bottom: 5rpx;
  left: 5rpx;
  width: calc((100% - 10rpx) / 3);
  border-radius: 999rpx;
  background: #2C2C2A;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.14);
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.sort-option {
  position: relative;
  z-index: 1;
  min-width: 88rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #5F5E5A;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  transition: color 180ms ease;
}

.sort-option-active {
  color: #FFFFFF;
  font-weight: 600;
}

.feed-stage {
  position: relative;
  min-height: calc(100vh - 360rpx);
  animation:feed-appear 140ms ease-out;
}
@keyframes feed-appear { from { opacity:.6; } to { opacity:1; } }
@media (prefers-reduced-motion:reduce) {
  .feed-stage { animation:none; }
  .sort-indicator,.sort-option { transition:none; }
}

.list-retry { color: #727B9E; }
.list-end {
  text-align: center;
  padding: 32rpx 0;
}

.feedback-bar { position: fixed; z-index: 50; left: 32rpx; right: 32rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; padding: 16rpx 24rpx; border-radius: 16rpx; background: #2C2C2A; color: #fff; font-size: 25rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.12); }
.feedback-undo { margin: 0; padding: 0 12rpx; background: transparent; color: #E1E5F0; font-size: 25rpx; line-height: 48rpx; }
.feedback-undo::after { border: none; }
