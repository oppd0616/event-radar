.d-head {
  padding: 40rpx 0 32rpx;
}

.chip {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.d-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A18;
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.d-summary {
  font-size: 26rpx;
  color: #5F5E5A;
  line-height: 1.7;
}

.d-hotwords {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.d-hotword {
  padding: 7rpx 14rpx;
  border-radius: 9rpx;
  color: #596FA6;
  background: #EFF2F9;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.2;
}

.d-countdown {
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.d-countdown-label {
  font-size: 22rpx;
  color: #706E68;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.d-countdown-label--ongoing {
  color: #D8443E;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.d-countdown-value {
  display: flex;
  justify-content: center;
  min-height: 58rpx;
  color: #242421;
}

.d-rows {
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
}

.d-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.d-row-label {
  font-size: 24rpx;
  color: #706E68;
}

.d-row-value {
  font-size: 26rpx;
  color: #1A1A18;
  max-width: 440rpx;
  text-align: right;
}

.d-row-pending {
  color: #706E68;
}

.d-guide {
  padding: 28rpx 30rpx 26rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 24rpx;
  background: #FFFFFF;
}

.d-timeline {
  padding: 28rpx 30rpx 18rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FAFBFD 100%);
}

.d-timeline-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.d-timeline-caption {
  color: #85817A;
  font-size: 21rpx;
}

.d-timeline-caption--pending {
  color: #A96C32;
}

.d-timeline-item {
  display: flex;
  min-height: 88rpx;
}

.d-timeline-rail {
  position: relative;
  flex: none;
  width: 34rpx;
}

.d-timeline-dot {
  position: relative;
  z-index: 2;
  width: 14rpx;
  height: 14rpx;
  margin: 9rpx 0 0 2rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: #C8C6C0;
  box-shadow: 0 0 0 2rpx rgba(90, 104, 139, 0.10);
}

.d-timeline-line {
  position: absolute;
  top: 25rpx;
  bottom: -9rpx;
  left: 9rpx;
  width: 2rpx;
  background: #E7E8EC;
}

.d-timeline-content {
  flex: 1;
  min-width: 0;
  padding: 0 0 24rpx 10rpx;
}

.d-timeline-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.d-timeline-name {
  color: #292925;
  font-size: 26rpx;
  font-weight: 500;
}

.d-timeline-state {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  color: #4D659C;
  background: #EEF2F8;
  font-size: 18rpx;
}

.d-timeline-time,
.d-timeline-venue {
  display: block;
  margin-top: 5rpx;
  color: #77746E;
  font-size: 22rpx;
  line-height: 1.45;
}

.d-timeline-item--active .d-timeline-dot {
  background: #D9574F;
  box-shadow: 0 0 0 7rpx rgba(217, 87, 79, 0.10);
}

.d-timeline-item--active .d-timeline-name {
  color: #A8423D;
}

.d-timeline-item--upcoming .d-timeline-dot {
  background: #657AAE;
  box-shadow: 0 0 0 6rpx rgba(101, 122, 174, 0.10);
}

.d-timeline-item--done .d-timeline-content {
  opacity: 0.62;
}

.d-guide-title {
  color: #1A1A18;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.d-guide-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.d-guide-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.d-guide-badge {
  padding: 6rpx 16rpx;
  border-radius: 9rpx;
  color: #4D659C;
  background: #EEF2F8;
  font-size: 21rpx;
  font-weight: 500;
}

.d-guide-rows {
  margin-top: 18rpx;
}

.d-guide-links {
  margin-top: 2rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.055);
}

.d-guide-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
}

.d-guide-link-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.d-guide-link-value {
  min-width: 0;
  color: #242421;
  font-size: 25rpx;
  text-align: right;
  overflow-wrap: break-word;
}

.d-guide-link-action {
  flex: none;
  padding: 6rpx 13rpx;
  border-radius: 999rpx;
  color: #4D659C;
  background: #EEF2F8;
  font-size: 20rpx;
}

.d-guide-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
}

.d-guide-row + .d-guide-row {
  border-top: 1rpx solid rgba(0, 0, 0, 0.055);
}

.d-guide-label {
  flex: none;
  width: 120rpx;
  color: #706E68;
  font-size: 24rpx;
  line-height: 1.55;
}

.d-guide-value-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.d-guide-value {
  display: block;
  max-width: 100%;
  color: #242421;
  font-size: 26rpx;
  line-height: 1.55;
  word-break: normal;
  overflow-wrap: break-word;
}

.d-guide-secondary {
  display: block;
  max-width: 100%;
  margin-top: 3rpx;
  color: #85817A;
  font-size: 23rpx;
  line-height: 1.5;
  word-break: normal;
  overflow-wrap: break-word;
}

.d-guide-row--stacked {
  display: block;
}

.d-guide-row--stacked .d-guide-label {
  display: block;
  width: auto;
}

.d-guide-row--stacked .d-guide-value-wrap {
  margin-top: 8rpx;
  align-items: flex-start;
  text-align: left;
}

.d-guide-row--stacked .d-guide-value {
  line-height: 1.65;
}

.d-guide-steps {
  padding-top: 20rpx;
  margin-top: 4rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.07);
}

.d-guide-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 14rpx;
}

.d-guide-step:first-child {
  margin-top: 0;
}

.d-guide-index {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #42609C;
  background: #EDF2FA;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 38rpx;
  text-align: center;
}

.d-guide-step-text {
  flex: 1;
  padding-top: 1rpx;
  color: #3B3A36;
  font-size: 24rpx;
  line-height: 1.55;
}

.d-academic {
  background: linear-gradient(145deg, rgba(242, 238, 249, 0.92), rgba(255, 255, 255, 0.96));
  border-color: rgba(110, 95, 143, 0.14);
}

.d-growth-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #655580;
  background: rgba(110, 95, 143, 0.10);
  font-size: 20rpx;
}

.d-academic-note {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(110, 95, 143, 0.10);
  color: #66625F;
  font-size: 21rpx;
  line-height: 1.55;
}

.d-source-card {
  padding-top: 0;
  padding-bottom: 0;
}

.d-source-row {
  min-width: 0;
}

.d-source-main {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  min-width: 0;
  max-width: 440rpx;
}

.d-source-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #4D5F99;
  font-size: 25rpx;
}

.d-source-action {
  flex: none;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #4D5F99;
  background: #F0F2F8;
  font-size: 20rpx;
}

.d-note {
  margin-top: 20rpx;
  text-align: center;
}

.d-bottom-bar {
  position: fixed;
  z-index: 20;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid #ECECE7;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 28rpx rgba(28, 28, 24, 0.075);
  box-sizing: border-box;
  -webkit-backdrop-filter: blur(36rpx) saturate(135%);
  backdrop-filter: blur(36rpx) saturate(135%);
}

.d-tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 80rpx;
  flex: 0 0 88rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  color: #4C4B47;
  background: transparent;
  font-size: 20rpx;
  line-height: 1.2;
}

.d-tool-active {
  background: #EEEDE8;
}

.d-bottom-tools { display: flex; flex: 0 0 188rpx; width:188rpx; min-width:0; gap: 12rpx; padding: 0; }
.d-remind-content { display: flex; align-items: center; justify-content: center; gap: 12rpx; color: #FFF; white-space:nowrap; }
.d-remind-title { font-size: 26rpx; font-weight: 500; line-height:1.2; }

.d-bottom-primary {
  flex: 1;
  min-width: 0;
}
.detail-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.d-follow-tool { margin: 0; padding: 0; transition: color 180ms ease, transform 180ms ease; }
.d-follow-tool::after { border: none; }
.d-follow-tool-active { color: #727B9E; background: transparent; }
.d-follow-tool[disabled] { opacity:.8;background:transparent; }
.d-follow-tool-active[disabled] { color:#727B9E; }
.detail-bookmark { display:flex;align-items:center;justify-content:center; }
.detail-bookmark-pulse { animation:detail-bookmark-confirm 180ms ease-out; }
@keyframes detail-bookmark-confirm { 0% { transform:scale(.9); } 65% { transform:scale(1.06); } 100% { transform:scale(1); } }
.detail-pending { padding:20rpx 0; }
.detail-pending-line { height:24rpx;background:#edeef0;border-radius:8rpx;margin-bottom:18rpx;width:88%; }
.detail-pending-short { width:58%; }
.detail-pending-block { height:220rpx;background:#f0f1f2;border-radius:24rpx;margin-top:38rpx; }
@media (prefers-reduced-motion:reduce) { .detail-bookmark-pulse { animation:none; } }
@media (prefers-reduced-motion: reduce) { .d-follow-tool { transition:none; } }
