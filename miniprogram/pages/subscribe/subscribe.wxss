.preference-page { padding-top: 26rpx; }
.interest-header, .section-heading { display:flex;align-items:center;justify-content:space-between; }
.interest-header { margin-bottom: 22rpx; }
.interest-title { font-size: 38rpx;font-weight: 600;color: #242521; }
.interest-subtitle { margin-top: 3rpx;color: #96988E;font-size: 22rpx; }
.edit-link { color: #6B7695;font-size: 25rpx;min-width: 64rpx;text-align: right; }
.interest-surface { background:#FFF;border-radius:20rpx;padding:28rpx 26rpx; }
.interest-chips,.topic-chips { display:flex;flex-wrap:wrap;gap:14rpx; }
.interest-chip { display:inline-flex;align-items:center;justify-content:center;min-height:66rpx;padding:0 22rpx;border-radius:12rpx;background:#ECEEF5;color:#4D5876;font-size:25rpx;box-sizing:border-box; }
.empty-interests,.empty-topics { color:#999B92;font-size:24rpx;min-height:50rpx;display:flex;align-items:center; }
.editor-label { color:#6E7068;font-size:23rpx;margin-bottom:16rpx; }
.editor-chips { gap:12rpx; }
.editor-chip { background:#FFF;border:1rpx solid #E7E8E3;color:#6E7168;transition:background 160ms ease,border-color 160ms ease,transform 160ms ease; }
.editor-chip.chip-selected { background:#ECEEF5;color:#4D5876;border-color:#ECEEF5; }
.editor-chip.chip-active { border-color:#8791AE; }
.editor-chip-pressed { opacity:.72; }
.preference-domain-icon { display:block;width:38rpx;height:38rpx;flex-shrink:0;margin-right:10rpx;transition:opacity 120ms ease; }
.editor-chip .preference-domain-icon { opacity:.65; }
.editor-chip.chip-selected .preference-domain-icon { opacity:1; }
.strength-editor { margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid #F0F0EB; }
.strength-heading { color:#6E7068;font-size:23rpx;margin-bottom:14rpx; }
.strength-options { position:relative;display:flex;padding:4rpx;background:#F6F6F3;border-radius:12rpx; }
.strength-indicator { position:absolute;left:4rpx;top:4rpx;bottom:4rpx;width:calc((100% - 8rpx) / 4);background:#E8EBF4;border-radius:9rpx;pointer-events:none;transition:transform 180ms cubic-bezier(.2,.8,.2,1); }
.strength-option { position:relative;z-index:1;flex:1;min-width:0;text-align:center;padding:15rpx 0;color:#7A7D74;font-size:22rpx; }
.strength-active { color:#4C5879;font-weight:500; }
.editor-note { color:#9B9D94;font-size:21rpx;margin-top:18rpx; }
.save-area { margin-top:24rpx; }
.sync-note { color:#7B819E;font-size:22rpx;padding:16rpx 4rpx 0; }
.section-heading { color:#42443E;font-size:26rpx;font-weight:500;margin:34rpx 4rpx 14rpx; }
.topic-surface { background:#FFF;border-radius:20rpx;padding:25rpx 26rpx; }
.topic-chip { display:inline-flex;align-items:center;min-height:53rpx;padding:0 16rpx;border-radius:9rpx;background:#F5F5F2;color:#63665F;font-size:23rpx; }
.topic-more { font-size:22rpx;color:#8A8D83;align-self:center; }
.topic-add { font-size:23rpx;color:#6B7695;align-self:center; }
.settings-group { background:#FFF;border-radius:18rpx;overflow:hidden; }
.setting-row { display:flex;align-items:center;gap:16rpx;min-height:94rpx;margin:0;padding:0 24rpx;box-sizing:border-box;position:relative;text-align:left; }
.setting-row + .setting-row::before { content:'';position:absolute;top:0;left:24rpx;right:0;height:1rpx;background:#EFEFEA;pointer-events:none; }
.row-title { flex:1;min-width:0;color:#30312E;font-size:27rpx;font-weight:400; }
.row-value { font-size:23rpx;color:#90938A; }
.chevron { flex:none;font-family:Arial,sans-serif;font-size:38rpx;line-height:1;color:#B8BBB2;display:inline-block;transition:transform 160ms ease; }
.chevron-open { transform:rotate(90deg); }
.row-pressed { background:#F6F6F2; }
.setting-switch { flex:none;transform:scale(.85);transform-origin:right center; }
.action-row { padding:0 24rpx;border-radius:0;background:transparent;font-weight:400;line-height:normal;width:100%; }
/* Native button resets must not override the shared press feedback. */
.setting-row.row-pressed,button.action-row.row-pressed { background:#F6F6F2; }
button.action-row::after { border:none; }
button.action-row[disabled] { background:transparent;opacity:.5; }
.group-note { padding:12rpx 24rpx 0;color:#999B92;font-size:21rpx;line-height:1.65; }
.record-list,.management-list { border-top:1rpx solid #EFEFEA;background:#FAFAF7; }
.record-row { display:flex;align-items:center;gap:24rpx;min-height:84rpx;padding:12rpx 24rpx;box-sizing:border-box; }
.record-row + .record-row { border-top:1rpx solid #EEEEE8; }
.record-title { flex:1;font-size:24rpx;color:#65685E;line-height:1.6; }
.record-value { flex:none;color:#94988B;font-size:22rpx; }
.record-message { padding:24rpx;font-size:24rpx;color:#989C90; }
.retry { color:#727D9B; }
.more-group { margin-top:30rpx; }
.management-list .row-title { font-size:26rpx; }
.danger-row .row-title { color:#AE625A; }
.about-copy { padding:0 24rpx 24rpx;color:#93978B;font-size:22rpx;line-height:1.8; }
@media (prefers-reduced-motion:reduce) { .chevron,.editor-chip,.preference-domain-icon,.strength-indicator { transition:none; } }
