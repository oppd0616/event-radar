.ob {
  min-height: 100vh;
  padding: 44rpx 40rpx 210rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.ambient {
  position: fixed;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  filter: blur(90rpx);
  opacity: 0.08;
  pointer-events: none;
  animation: drift 12s ease-in-out infinite alternate;
}

.ambient-a {
  top: -180rpx;
  right: -160rpx;
  background: #5F6FA8;
}

.ambient-b {
  left: -240rpx;
  bottom: 80rpx;
  background: #E07B00;
  animation-delay: -3s;
}

.progress-head {
  position: relative;
  z-index: 1;
  margin-bottom: 54rpx;
}

.progress-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.step-text {
  font-size: 20rpx;
  color: #706E68;
  letter-spacing: 2rpx;
}

.progress-labels {
  display: flex;
  gap: 22rpx;
}

.progress-label {
  font-size: 20rpx;
  color: #706E68;
}

.progress-label-active {
  color: #34332F;
}

.progress-track {
  flex: 1;
  height: 4rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.08);
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: #2C2C2A;
  transition: width 320ms ease;
}

.step-1 { width: 33.333%; }
.step-2 { width: 66.666%; }
.step-3 { width: 100%; }

.panel {
  position: relative;
  z-index: 1;
}

.panel-in {
  animation: panel-in 360ms cubic-bezier(.2, .8, .2, 1) both;
}

.ob-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #706E68;
  margin-bottom: 14rpx;
}

.ob-title {
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.28;
  color: #1A1A18;
  margin-bottom: 18rpx;
}

.ob-desc {
  max-width: 620rpx;
  font-size: 25rpx;
  color: #6C6A64;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.trust-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 38rpx;
  color: #706E68;
  font-size: 21rpx;
}

.trust-dot {
  color: #C6C3BA;
}

.domain-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.domain-card {
  position: relative;
  min-height: 154rpx;
  padding: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  animation: card-rise 420ms cubic-bezier(.2, .8, .2, 1) both;
  transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
}

.domain-active {
  transform: translateY(-4rpx);
  box-shadow: 0 14rpx 36rpx rgba(25, 25, 20, 0.08);
}

.domain-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.domain-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.domain-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  border-radius: 50%;
  color: #706E68;
  background: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}

.domain-label {
  font-size: 30rpx;
  font-weight: 550;
  color: #1A1A18;
}

.domain-state {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #706E68;
}

.domain-active .domain-state {
  color: #3E3D39;
}

.domain-active .domain-check {
  color: #FFFFFF;
  border-color: #2C2C2A;
  background: #2C2C2A;
}

.domain-tabs {
  width: calc(100% + 40rpx);
  margin-bottom: 30rpx;
}

.domain-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 40rpx;
  white-space: nowrap;
}

.domain-tab {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #77746D;
  background: #EFEEE9;
}

.domain-tab-active {
  color: #FFFFFF;
  background: #2C2C2A;
}

.topic-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.academic-section-title {
  margin-bottom: 6rpx;
  color: #262522;
  font-size: 27rpx;
  font-weight: 600;
}

.academic-section-copy {
  margin-bottom: 18rpx;
  color: #68665F;
  font-size: 21rpx;
  line-height: 1.5;
}

.academic-section-gap {
  margin-top: 34rpx;
}

.topic-card {
  position: relative;
  min-height: 126rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  animation: card-rise 360ms cubic-bezier(.2, .8, .2, 1) both;
  transition: transform 160ms ease, border-color 160ms ease;
}

.topic-active {
  border-color: #2C2C2A;
  transform: scale(1.025);
}

.topic-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-right: 28rpx;
}

.topic-label {
  font-size: 26rpx;
  color: #1A1A18;
  font-weight: 500;
}

.trend-mark {
  padding: 0 7rpx;
  border-radius: 6rpx;
  font-size: 17rpx;
  line-height: 28rpx;
  color: #B45722;
  background: #FFF0E5;
}

.topic-score {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #706E68;
}

.topic-check {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  font-size: 26rpx;
  color: #706E68;
}

.topic-active .topic-check {
  color: #2C2C2A;
}

.option-title {
  margin: 8rpx 0 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #292925;
}

.city-title {
  margin-top: 42rpx;
}

.growth-goal-hint {
  margin: -8rpx 0 18rpx;
  color: #64625C;
  font-size: 21rpx;
  line-height: 1.55;
}

.pill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-pill {
  padding: 14rpx 25rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.09);
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #65635D;
  font-size: 24rpx;
  transition: transform 160ms ease, color 160ms ease, background 160ms ease;
}

.option-active {
  color: #FFFFFF;
  background: #2C2C2A;
  transform: scale(1.03);
}

.learning-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 36rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.78);
}

.learning-copy {
  flex: 1;
  min-width: 0;
}

.learning-title {
  color: #242421;
  font-size: 25rpx;
  font-weight: 600;
}

.learning-desc {
  margin-top: 6rpx;
  color: #64625C;
  font-size: 21rpx;
  line-height: 1.5;
}

.summary-card {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(50, 59, 96, 0.08);
  background: rgba(238, 239, 246, 0.72);
}

.summary-orbit {
  position: absolute;
  width: 170rpx;
  height: 170rpx;
  right: -40rpx;
  top: -70rpx;
  border: 1rpx solid rgba(43, 76, 255, 0.24);
  border-radius: 50%;
  opacity: 0.65;
  animation: orbit 10s linear infinite;
}

.summary-title {
  position: relative;
  font-size: 28rpx;
  color: #20243A;
  font-weight: 600;
}

.summary-text {
  position: relative;
  margin-top: 8rpx;
  color: #6C718E;
  font-size: 23rpx;
}

.ob-actions {
  position: fixed;
  z-index: 5;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  background: rgba(250, 250, 248, 0.96);
}

.back {
  text-align: center;
  padding: 8rpx 0 16rpx;
  color: #64625C;
  font-size: 23rpx;
}

.skip {
  text-align: center;
  font-size: 22rpx;
  color: #706E68;
  padding: 20rpx 0 0;
}

@keyframes panel-in {
  from { opacity: 0; transform: translateX(24rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes card-rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes drift {
  from { transform: translate3d(0, 0, 0) scale(1); }
  to { transform: translate3d(42rpx, 58rpx, 0) scale(1.12); }
}

@keyframes orbit {
  from { transform: rotate(0deg) scale(.9); }
  to { transform: rotate(360deg) scale(1.06); }
}
