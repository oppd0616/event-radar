page {
  --td-brand-color: #2C2C2A;
  --td-brand-color-active: #000000;
  --td-brand-color-focus: #444441;
  --td-brand-color-light: #F1EFE8;
  --td-success-color: #3B6D11;
  --td-warning-color: #BA7517;
  --td-error-color: #A32D2D;
  --td-text-color-primary: #1A1A18;
  --td-text-color-secondary: #5F5E5A;
  --td-text-color-placeholder: #706E68;
  --td-bg-color-container: #FFFFFF;
  --td-bg-color-page: #FAFAF8;
  --td-radius-default: 12rpx;
  --td-radius-large: 24rpx;
  --td-font-size-m: 28rpx;
  background: #FAFAF8;
  color: #1A1A18;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page-container {
  min-height: 100vh;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.page-container.tab-page { padding-bottom: calc(136rpx + env(safe-area-inset-bottom)); }

.hairline {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.08);
}

.text-weak {
  color: #706E68;
  font-size: 22rpx;
}

.text-secondary {
  color: #5F5E5A;
  font-size: 24rpx;
}
