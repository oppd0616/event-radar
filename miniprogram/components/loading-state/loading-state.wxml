<view class="loading-state loading-state--{{kind}}" aria-role="status" aria-label="{{label}}">
  <view class="loading-caption"><view class="loading-dot"></view><text>{{label}}</text></view>
  <view wx:if="{{kind === 'detail'}}" class="loading-intro" aria-hidden="{{true}}">
    <view class="skeleton skeleton-chip"></view>
    <view class="skeleton skeleton-title"></view>
    <view class="skeleton skeleton-title skeleton-short"></view>
    <view class="skeleton skeleton-line"></view>
  </view>
  <view class="loading-card" wx:for="{{rows}}" wx:key="*this" aria-hidden="{{true}}">
    <view class="loading-date" wx:if="{{kind === 'agenda'}}"><view class="skeleton skeleton-month"></view><view class="skeleton skeleton-day"></view></view>
    <view class="loading-content">
      <view class="loading-top"><view class="skeleton skeleton-chip"></view><view class="skeleton skeleton-status"></view></view>
      <view class="skeleton skeleton-title"></view>
      <view class="skeleton skeleton-line"></view>
      <view class="skeleton skeleton-line skeleton-short"></view>
      <view class="loading-bottom" wx:if="{{kind === 'feed'}}"><view class="skeleton skeleton-source"></view><view class="skeleton skeleton-button"></view></view>
    </view>
  </view>
</view>
