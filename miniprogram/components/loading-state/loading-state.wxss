.loading-state { padding: 4rpx 0 20rpx; }
.loading-caption { display: flex; align-items: center; gap: 12rpx; min-height: 48rpx; margin-bottom: 14rpx; color: #85847E; font-size: 22rpx; }
.loading-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #9B9FAD; }
.loading-card { display: flex; padding: 28rpx 32rpx; margin-bottom: 20rpx; background: #FFFFFF; border: 1rpx solid rgba(0,0,0,.06); border-radius: 24rpx; }
.loading-content { flex: 1; min-width: 0; }
.loading-top, .loading-bottom { display: flex; justify-content: space-between; align-items: center; }
.loading-top { margin-bottom: 26rpx; }
.loading-bottom { margin-top: 26rpx; }
.skeleton { background: #F0F0EC; border-radius: 6rpx; animation: skeleton-breathe 1600ms ease-in-out infinite; }
.skeleton-chip { width: 72rpx; height: 28rpx; }
.skeleton-status { width: 116rpx; height: 20rpx; }
.skeleton-title { width: 88%; height: 30rpx; margin-bottom: 18rpx; }
.skeleton-line { width: 100%; height: 22rpx; margin-bottom: 14rpx; }
.skeleton-short { width: 64%; }
.skeleton-source { width: 150rpx; height: 20rpx; }
.skeleton-button { width: 148rpx; height: 58rpx; border-radius: 30rpx; }
.loading-date { width: 74rpx; margin-right: 26rpx; border-right: 1rpx solid #F0F0EC; }
.skeleton-month { width: 42rpx; height: 20rpx; margin: 6rpx 0 16rpx; }
.skeleton-day { width: 42rpx; height: 46rpx; }
.loading-intro { padding: 16rpx 0 32rpx; }
.loading-intro .skeleton-chip { margin-bottom: 28rpx; }
.loading-intro .skeleton-title { height: 42rpx; }
.loading-intro .skeleton-line { margin-top: 24rpx; }
.loading-state--detail .loading-card { min-height: 112rpx; }
@keyframes skeleton-breathe { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
